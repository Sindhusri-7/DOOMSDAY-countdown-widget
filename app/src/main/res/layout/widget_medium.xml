<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null"/>

    <ImageButton android:id="@+id/gear" android:layout_width="26dp" android:layout_height="26dp"
        android:layout_gravity="top|end" android:layout_margin="6dp" android:background="@null"
        android:src="@android:drawable/ic_menu_preferences" android:contentDescription="Customize"/>

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal|top" android:padding="0dp">

        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="14dp" android:textStyle="bold"
            android:letterSpacing="0.12" android:maxLines="1" android:includeFontPadding="false"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/mo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00" android:textColor="#FFFFFF" android:textSize="24dp"
                    android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"/>
                <TextView android:id="@+id/l_mo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MONTHS" android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1"/>
            </LinearLayout>

            <TextView android:id="@+id/c1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginBottom="8dp"
                android:text=":" android:textColor="#B3FFFFFF" android:textSize="24dp"
                android:textStyle="bold" android:includeFontPadding="false"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/dd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="00" android:textColor="#FFFFFF" android:textSize="24dp"
                    android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"/>
                <TextView android:id="@+id/l_dd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DAYS" android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1"/>
            </LinearLayout>

            <TextView android:id="@+id/c2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:layout_marginBottom="8dp"
                android:text=":" android:textColor="#B3FFFFFF" android:textSize="24dp"
                android:textStyle="bold" android:includeFontPadding="false"/>

            <!-- LIVE hours:minutes:seconds, ticks every second by itself -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center">
                <Chronometer android:id="@+id/sec" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="24dp" android:textStyle="bold"
                    android:maxLines="1" android:includeFontPadding="false"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/l_h" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:text="HOURS"
                        android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1"/>
                    <TextView android:id="@+id/l_m" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:text="MINUTES"
                        android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1"/>
                    <TextView android:id="@+id/l_s" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="center" android:text="SECONDS"
                        android:textColor="#B3FFFFFF" android:textSize="8dp" android:maxLines="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:visibility="gone"
            android:layout_marginTop="14dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
            android:progressTint="#8BFF6A" android:progressBackgroundTint="#33FFFFFF" android:max="1000"/>
        <TextView android:id="@+id/caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone"
            android:textColor="#B3FFFFFF" android:textSize="12dp"/>
    </LinearLayout>
</FrameLayout>
