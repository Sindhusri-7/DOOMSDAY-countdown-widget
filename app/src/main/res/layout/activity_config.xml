<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="160dp">
        <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:contentDescription="Preview"/>
        <TextView android:id="@+id/sample" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:text="DOOMSDAY IS COMING\n00 : 20 : 16 : 23 : 56" android:gravity="center"
            android:textSize="22sp" android:textStyle="bold"/>
    </FrameLayout>

    <Button android:id="@+id/preset" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Use Doomsday preset (poster + title + release time)"/>

    <EditText android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Title" android:inputType="textCapCharacters" android:maxLines="1"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <Button android:id="@+id/time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Widget style (you can also resize the widget freely)" android:textStyle="bold"/>
    <RadioGroup android:id="@+id/mode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <RadioButton android:id="@+id/mode_auto" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Auto (changes with widget size)"/>
        <RadioButton android:id="@+id/mode_boxes" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Boxes: months / days / hours:minutes:seconds"/>
        <RadioButton android:id="@+id/mode_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="One line: days + live timer"/>
    </RadioGroup>


    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Text size" android:textStyle="bold"/>
    <SeekBar android:id="@+id/tsize" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Text position (up to down)" android:textStyle="bold"/>
    <SeekBar android:id="@+id/tpos" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <CheckBox android:id="@+id/show_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Show green progress line + date under the timer"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Background" android:textStyle="bold"/>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <RadioGroup android:id="@+id/themes" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>
    <Button android:id="@+id/photo" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Browse picture from gallery"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Darken background" android:textStyle="bold"/>
    <SeekBar android:id="@+id/dim" android:layout_width="match_parent" android:layout_height="wrap_content"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Digit color" android:textStyle="bold"/>
    <LinearLayout android:id="@+id/colors" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"/>

    <Button android:id="@+id/sound" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Choose sound / music"/>

    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Save widget"/>
</LinearLayout>
</ScrollView>
